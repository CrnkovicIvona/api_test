      "item": [
        {
          "name": "GET /users/8 returns a valid user object",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('User has the expected structure', function () {",
                  "    pm.expect(body.id).to.eql(8);",
                  "    pm.expect(body.name).to.be.a('string');",
                  "    pm.expect(body.username).to.be.a('string');",
                  "    pm.expect(body.email).to.be.a('string');",
                  "    pm.expect(body.address.street).to.be.a('string');",
                  "    pm.expect(body.address.suite).to.be.a('string');",
                  "    pm.expect(body.address.city).to.be.a('string');",
                  "    pm.expect(body.address.zipcode).to.be.a('string');",
                  "    pm.expect(body.address.geo.lat).to.be.a('string');",
                  "    pm.expect(body.address.geo.lng).to.be.a('string');",
                  "    pm.expect(body.phone).to.be.a('string');",
                  "    pm.expect(body.website).to.be.a('string');",
                  "    pm.expect(body.company.name).to.be.a('string');",
                  "    pm.expect(body.company.catchPhrase).to.be.a('string');",
                  "    pm.expect(body.company.bs).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
